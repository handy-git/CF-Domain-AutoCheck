{
  // Cloudflare Workers 配置（Workers Builds / wrangler deploy 使用）
  "name": "cf-domain-autocheck",
  // 项目入口为单文件 Worker（Service Worker 语法）
  "main": "_worker.js",
  "compatibility_date": "2026-08-27",
  // KV 存储：域名/分类/邮件配置全部存于此命名空间
  // ⚠️ 部署前替换为你的 KV namespace ID（dashboard 左侧 KV 创建后复制）
  "kv_namespaces": [
    { "binding": "DOMAIN_MONITOR", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }
  ],
  // 定时触发：每周一北京时间 10:00（UTC 02:00）自动检查到期域名并发送邮件
  "triggers": {
    "crons": ["0 2 * * 1"]
  }
}
