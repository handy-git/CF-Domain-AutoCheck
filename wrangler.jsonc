{
  // Cloudflare Workers 配置（Workers Builds / wrangler deploy 使用）
  "name": "autocheck",
  // 项目入口为单文件 Worker（Service Worker 语法）
  "main": "_worker.js",
  "compatibility_date": "2026-08-27",
  // 保留面板中设置的环境变量（否则每次部署会清空未写入配置的纯文本变量）
  "keep_vars": true,
  // KV 存储：域名/分类/邮件配置全部存于此命名空间
  "kv_namespaces": [
    { "binding": "DOMAIN_MONITOR", "id": "3ac2b8256e6649aeb6f3f7d5a927ca27" }
  ],
  // 定时触发：每周一北京时间 10:00（UTC 02:00）自动检查到期域名并发送邮件
  "triggers": {
    "crons": ["0 2 * * 1"]
  }
}
